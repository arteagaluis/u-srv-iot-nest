# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
PORT=3000

# Trusted origins for CORS (comma-separated)
# Example: https://teliot.site,https://app.teliot.site
CORS_ORIGINS=https://teliot.site

# =============================================================================
# MongoDB
# =============================================================================
# Local development
# MONGODB_URI=mongodb://localhost:27017/iot-auth-db

# Docker Compose (uses service name as hostname)
MONGODB_URI=mongodb://mongo:27017/iot-auth-db

# Production with authentication
# MONGODB_URI=mongodb://user:password@mongo:27017/iot-auth-db?authSource=admin

# =============================================================================
# Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id-here

# =============================================================================
# JWT Secrets (use strong random strings in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET=change-me-to-a-strong-random-string
JWT_REFRESH_SECRET=change-me-to-another-strong-random-string
JWT_ACCESS_EXPIRATION=15m

# =============================================================================
# Skip Google Auth (development only, MUST be false in production)
# =============================================================================
SKIP_GOOGLE_AUTH=false
